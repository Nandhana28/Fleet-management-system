# FleetPulse — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ─── Mode Toggle ─────────────────────────────────────────────────────────────
# true  = use LocalStack (local dev, no AWS needed)
# false = use real AWS (integration testing with Farhana's account)
USE_LOCALSTACK=true

# ─── AWS Credentials (only needed when USE_LOCALSTACK=false) ─────────────────
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=ap-south-1

# ─── LocalStack ───────────────────────────────────────────────────────────────
LOCALSTACK_ENDPOINT=http://localhost:4566

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=dev-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── Twilio (WhatsApp alerts — Week 4) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Anthropic (AI agent — Week 3) ───────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
FRONTEND_URL=http://localhost:3000
